# Melouz OS environment configuration
# Copy this file to .env.local and fill in what you need.

# ---- Vercel deployment (production) ----
# In production on Vercel the JSON database is stored in a PRIVATE Vercel Blob
# store instead of the local filesystem. Create a blob store in the Vercel
# dashboard and set this token. Local development never needs it.
BLOB_READ_WRITE_TOKEN=

# ---- AI assistant (optional) ----
# Without AI_API_KEY the assistant responds with setup instructions instead
# of making up answers.
AI_API_KEY=
# OpenAI-compatible endpoint. Defaults to https://api.openai.com/v1
AI_API_BASE_URL=
# Model name. Defaults to gpt-4o-mini
AI_MODEL=

# ---- App configuration ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Seeded default admin + shared company workspace ----
# Created automatically on first run. In local development the default
# credentials below apply; in production (NODE_ENV=production) with
# DEFAULT_ADMIN_PASSWORD unset a random password is generated and printed
# once to the server logs — set it explicitly to choose your own.
DEFAULT_ADMIN_EMAIL=admin@melouz.local
DEFAULT_ADMIN_PASSWORD=admin12345
COMPANY_WORKSPACE_NAME=Melouz Company

# ---- Local data store ----
# Where the JSON data store lives in local development. Defaults to
# ~/.melouz-os/data (kept outside the project folder on purpose: writing it
# inside the project makes Next.js/Turbopack recompile on every change).
MELOUZ_DATA_DIR=
