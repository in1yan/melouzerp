# Melouz OS environment configuration
# Copy this file to .env.local and fill in what you need.
# The app runs with NO configuration required — auth and data are local.

# AI assistant (optional). Without AI_API_KEY the assistant responds with
# setup instructions instead of making up answers.
AI_API_KEY=
# OpenAI-compatible endpoint. Defaults to https://api.openai.com/v1
AI_API_BASE_URL=
# Model name. Defaults to gpt-4o-mini
AI_MODEL=

# App configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Seeded default admin + shared company workspace (optional; defaults shown).
# Created automatically on first run. Change these before first launch if you want
# different credentials. There is no public admin sign-up — admins invite/approve.
DEFAULT_ADMIN_EMAIL=admin@melouz.local
DEFAULT_ADMIN_PASSWORD=admin12345
COMPANY_WORKSPACE_NAME=Melouz Company

# Where the JSON data store lives. Defaults to ~/.melouz-os/data (kept outside
# the project folder on purpose: writing it inside the project makes Next.js/Turbopack
# recompile on every change, showing a "Compiling…" overlay to every connected user).
MELOUZ_DATA_DIR=
